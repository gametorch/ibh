{
  "name": "@gametorch/ibh-solid",
  "version": "0.2.0",
  "description": "SolidJS bindings for ibh \u2014 a drop-in <IbhChat /> component and use:ibhChat directive, gated by a capability manifest.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gametorch/ibh": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.17"
  },
  "keywords": [
    "gametorch",
    "ibh",
    "solid",
    "solidjs",
    "agent",
    "chatbot",
    "ai"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gametorch/ibh.git"
  },
  "homepage": "https://gametorch.app",
  "prepack": "pnpm -w build"
}
